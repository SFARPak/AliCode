{
	"name": "alicode",
	"displayName": "AliCode: AI Coding Assistant",
	"description": "%extension.description%",
	"publisher": "AliCode",
	"version": "3.53.0",
	"icon": "assets/icons/icon-dark.png",
	"galleryBanner": {
		"color": "#617A91",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.84.0",
		"node": "22.x"
	},
	"author": {
		"name": "AliCode"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/SFARPak/AliCode"
	},
	"homepage": "https://github.com/SFARPak/AliCode",
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"cline",
		"claude",
		"dev",
		"mcp",
		"openrouter",
		"coding",
		"agent",
		"autonomous",
		"chatgpt",
		"sonnet",
		"ai",
		"llama",
		"alicode"
	],
	"activationEvents": [
		"onLanguage",
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "alicode-ActivityBar",
					"title": "%views.activitybar.title%",
					"icon": "assets/icons/icon-light.svg"
				}
			]
		},
		"views": {
			"alicode-ActivityBar": [
				{
					"type": "webview",
					"id": "alicode.SidebarProvider",
					"name": "%views.sidebar.name%"
				},
				{
					"type": "webview",
					"id": "alicode.KiloClawPanel",
					"name": "KiloClaw"
				},
				{
					"type": "webview",
					"id": "alicode.MarketplacePanel",
					"name": "Marketplace"
				},
				{
					"type": "webview",
					"id": "alicode.AgentManagerPanel",
					"name": "Agent Manager"
				},
				{
					"type": "webview",
					"id": "alicode.SettingsEditorPanel",
					"name": "Settings"
				},
				{
					"type": "webview",
					"id": "alicode.SubAgentViewerPanel",
					"name": "Sub Agent Viewer"
				}
			]
		},
