{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@ali-code/kilo-gateway",
	"version": "7.4.1",
	"type": "module",
	"license": "MIT",
	"description": "Unified Kilo Gateway package for Ali Code - authentication, provider, and API integration",
	"keywords": [
		"ali",
		"alicode",
		"opencode",
		"auth",
		"plugin",
		"provider",
		"ai",
		"llm"
	],
	"exports": {
		".": "./src/index.ts",
		"./autocomplete": "./src/autocomplete.ts",
		"./fim": "./src/fim.ts",
		"./edit": "./src/edit.ts",
		"./edit-prompt": "./src/edit-prompt.ts",
		"./tui": "./src/tui.ts"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "tsc",
		"test:ci": "mkdir -p .artifacts/unit && vitest run test --dots --reporter=junit --reporter-outfile=.artifacts/unit/junit.xml"
	},
	"dependencies": {
		"@ali-code/plugin": "workspace:*",
		"@ai-sdk/alibaba": "1.0.17",
		"@ai-sdk/anthropic": "3.0.71",
		"@ai-sdk/openai": "3.0.53",
		"@ai-sdk/openai-compatible": "2.0.48",
		"@ai-sdk/mistral": "3.0.27",
		"@openrouter/ai-sdk-provider": "2.9.0",
		"@clack/prompts": "1.0.0-alpha.1",
		"ai": "catalog:",
		"open": "10.1.2",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@tsconfig/node22": "catalog:",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"solid-js": "catalog:",
		"@opentui/core": "catalog:",
		"@opentui/solid": "catalog:"
	},
	"peerDependencies": {
		"solid-js": "*",
		"@opentui/core": "*",
		"@opentui/solid": "*"
	},
	"peerDependenciesMeta": {
		"solid-js": {
			"optional": true
		},
		"@opentui/core": {
			"optional": true
		},
		"@opentui/solid": {
			"optional": true
		}
	}
}
